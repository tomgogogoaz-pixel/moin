PORT=4173
HOST=127.0.0.1
DB_PATH=./data/moin.sqlite
NODE_ENV=development

# mock is the safe local default. Gemini is enabled only when all model values exist.
AI_PROVIDER=mock
AI_MOCK_DELAY_MS=450
AI_ANALYZE_LIMIT_PER_HOUR=20
ENABLE_DEMO_AUTH=false
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_RETRY_ATTEMPTS=5
GEMINI_RETRY_BASE_MS=1000
GEMINI_RETRY_MAX_MS=15000

# Future Supabase adapter settings. The current repository remains local SQLite.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
